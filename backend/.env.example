# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide your MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/radhe_windson_erp

# Security & Session Management
JWT_SECRET=replace_with_min_32_char_cryptographically_secure_random_key
JWT_EXPIRES_IN=2h
CLIENT_URL=http://localhost:5173

# Initial Administrator Provisioning (CLI Seeder: npm run seed:admin)
INITIAL_ADMIN_NAME="Radhe Windson Administrator"
INITIAL_ADMIN_EMAIL=admin@radhewindson.local
INITIAL_ADMIN_PASSWORD=replace_with_strong_password_min_10_chars
